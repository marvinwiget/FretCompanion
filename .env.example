# Copy to .env for a new installation. Do not overwrite an existing .env.
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value stable across application restarts.
FLASK_SECRET_KEY=

# Used when a song needs a new guitar analysis.
GEMINI_API_KEY=

# Optional. If omitted, use fret_companion.db in the project root.
# Use an absolute path when choosing another SQLite file.
# DATABASE_URL=sqlite+pysqlite:////absolute/path/fret_companion.db
